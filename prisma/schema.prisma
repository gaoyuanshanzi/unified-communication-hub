// Prisma 스키마 - Neon PostgreSQL 연결
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 관리자 세션 로그
model AdminSession {
  id          String    @id @default(cuid())
  createdAt   DateTime  @default(now())
  loggedOutAt DateTime?
  ipAddress   String?
  userAgent   String?

  @@map("admin_sessions")
}

// 접근 로그
model AccessLog {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  path      String
  ipAddress String?
  method    String   @default("GET")

  @@map("access_logs")
}

// 저장된 메일 계정 설정 (IMAP)
model MailAccount {
  id        String   @id @default(cuid())
  provider  String   // "kakao" | "naver" | "gmail"
  email     String   @unique
  password  String   // 암호화된 앱 비밀번호
  host      String   // e.g. "imap.naver.com"
  port      Int      @default(993)
  secure    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("mail_accounts")
}
